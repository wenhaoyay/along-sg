# OneMap
ONEMAP_MOCK=true
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_BASE_URL=https://www.onemap.gov.sg
ONEMAP_TIMEOUT_SECONDS=15
ONEMAP_TOKEN_REFRESH_MARGIN_SECONDS=300
ONEMAP_MAX_RETRIES=2
ONEMAP_RETRY_BACKOFF_SECONDS=0.2
ONEMAP_DEPARTURE_TIME_ROUTING_VERIFIED=true

# Optimiser
OPTIMIZER_DETOUR_WEIGHT=1.0
OPTIMIZER_WALK_WEIGHT=0.65
OPTIMIZER_TRANSFER_WEIGHT=6.0
OPTIMIZER_PREFERRED_BRAND_BONUS=2.0
OPTIMIZER_CONSOLIDATED_STOP_BONUS=1.0
OPTIMIZER_DATA_QUALITY_BONUS=2.5
OPTIMIZER_MAX_CANDIDATES=4
OPTIMIZER_MAX_STRAIGHT_LINE_DETOUR_KM=12
OPTIMIZER_MAX_REASONABLE_DETOUR_MINUTES=45
OPTIMIZER_CORRIDOR_KM=2.5
OPTIMIZER_ENDPOINT_RADIUS_KM=2.0
OPTIMIZER_MAX_TRANSIT_NODE_DISTANCE_M=1200
OPTIMIZER_MAX_HUBS_PER_CATEGORY=8
OPTIMIZER_ROUTING_SOFT_BUDGET=10
OPTIMIZER_ROUTING_HARD_BUDGET=12
OPTIMIZER_ROUTING_CONCURRENCY=1
ROUTE_CACHE_MAX_ENTRIES=512
ROUTE_CACHE_TTL_SECONDS=300
ROUTE_CACHE_DEPARTURE_BUCKET_MINUTES=1

# Optional intent parsing
LLM_INTENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=20

# Optional live discovery
DISCOVERY_LIVE_ENABLED=false
TOMTOM_API_KEY=
GEOAPIFY_API_KEY=
DISCOVERY_WEB_ENABLED=false
TAVILY_API_KEY=
DISCOVERY_SEMANTIC_LLM_ENABLED=false
DISCOVERY_TIMEOUT_SECONDS=5
DISCOVERY_CACHE_TTL_SECONDS=300
DISCOVERY_HARD_BUDGET=3
DISCOVERY_PROVIDER_MAX_RETRIES=1
DISCOVERY_PRIMARY_CALLS_PER_NEED=2
DISCOVERY_SECONDARY_CALLS_PER_NEED=1
DISCOVERY_WEB_CALLS_PER_NEED=1
DISCOVERY_GROUNDING_CANDIDATE_LIMIT=4
DISCOVERY_GAP_TELEMETRY_ENABLED=false

# Expected errand dwell time (minutes)
DWELL_GROCERIES_MINUTES=20
DWELL_PHARMACY_MINUTES=10
DWELL_PARCEL_MINUTES=8
DWELL_ELECTRONICS_MINUTES=15
DWELL_BANKING_MINUTES=15
DWELL_FAST_FOOD_MINUTES=15
DWELL_FRIED_CHICKEN_MINUTES=15
DWELL_BUBBLE_TEA_MINUTES=8
DWELL_COFFEE_MINUTES=12
DWELL_CONVENIENCE_MINUTES=5

# App / beta
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ANALYTICS_DATABASE_PATH=backend/data/analytics.db
ANALYTICS_RETENTION_DAYS=90
BETA_ADMIN_TOKEN=
OPTIMIZATION_TIMEOUT_SECONDS=45
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SERVE_FRONTEND_DIR=
